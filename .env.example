# ---------------------------------------------------------------------------
# ForgeStock environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# NEVER commit real credentials. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Safe for the browser; protected by RLS.
# In the Supabase dashboard this is the "anon"/"publishable" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application display name. Change this to rename the app everywhere.
NEXT_PUBLIC_APP_NAME=ForgeStock

# Public site URL, used for auth redirects and the PWA manifest.
# Local: http://localhost:3000  Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
